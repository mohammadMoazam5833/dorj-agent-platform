{
 "title": "Dorj Agent",
 "uid": "nova-agent",
 "tags": [
  "nova"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "templating": {
  "list": [
   {
    "name": "ds",
    "type": "datasource",
    "query": "prometheus",
    "current": {}
   }
  ]
 },
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Workspaces ready",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(nova_workspaces{state=\"ready\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Workspaces stopped (scale-to-zero)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(nova_workspaces{state=\"stopped\"})",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Open agent sessions (WS)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(nova_websocket_connections)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "API availability (24h)",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "1 - sum(increase(nova_http_requests_total{code=~\"5..\"}[24h])) / clamp_min(sum(increase(nova_http_requests_total[24h])),1)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Requests/s by route",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum by (route) (rate(nova_http_requests_total[5m]))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "5xx ratio",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(nova_http_requests_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(nova_http_requests_total[5m])),1e-9)",
     "legendFormat": "5xx",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Workspace start p50/p95 (s)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum by (le,kind) (rate(nova_workspace_start_seconds_bucket[30m])))",
     "legendFormat": "p50 {{kind}}",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum by (le,kind) (rate(nova_workspace_start_seconds_bucket[30m])))",
     "legendFormat": "p95 {{kind}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Proxy overhead p95 (s)",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le) (rate(nova_proxy_request_seconds_bucket[5m])))",
     "legendFormat": "p95",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Workspace lifecycle events",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (event) (increase(nova_workspace_events_total[1h]))",
     "legendFormat": "{{event}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "LLM tokens/s for Dorj Agent users (LiteLLM)",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum by (requested_model) (rate(litellm_total_tokens_metric_total{api_key_alias=~\"nova-.*\"}[5m]))",
     "legendFormat": "{{requested_model}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "LLM spend (USD/h) for Dorj Agent",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(litellm_spend_metric_total{api_key_alias=~\"nova-.*\"}[1h]))*3600",
     "legendFormat": "USD/h",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Workspace CPU / memory",
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${ds}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"nova-ws\",container=\"agent-server\"}[5m]))",
     "legendFormat": "CPU cores",
     "refId": "A"
    },
    {
     "expr": "sum(container_memory_working_set_bytes{namespace=\"nova-ws\",container=\"agent-server\"})/2^30",
     "legendFormat": "Memory GiB",
     "refId": "B"
    }
   ]
  }
 ]
}